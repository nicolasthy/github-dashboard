{
  "private": true,
  "name": "github-dashboard",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.2.20",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun turbo build",
    "test": "bun turbo test",
    "typecheck": "bun turbo typecheck",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "^1.3.14",
    "lefthook": "1.x",
    "turbo": "2.x",
    "typescript": "5.x"
  }
}
